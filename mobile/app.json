{
  "expo": {
    "name": "podslushano",
    "slug": "podslushanonl",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "podslushano",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "nl.podslushano.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF6EF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "nl.podslushano.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4F5F7",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0E1014"
          },
          "imageWidth": 160
        }
      ],
      "expo-image",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "podslushano.nl открывает фото, чтобы вы могли поставить его на аватар.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "podslushano.nl определяет вашу провинцию, чтобы показывать афишу, места и контакты рядом с вами."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FF5A1F",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/app"
    },
    "extra": {
      "eas": {
        "projectId": "9ebb4a25-1e58-4360-8d5b-0bc0f0ddb026"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
