{
  "expo": {
    "name": "podslushano",
    "slug": "podslushanonl",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "podslushano",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "nl.podslushano.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "nl.podslushano.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#121212"
          }
        }
      ],
      "expo-image",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "podslushano открывает фото, чтобы вы могли добавить снимок к посту, истории или объявлению.",
          "cameraPermission": "podslushano использует камеру, чтобы вы могли снять фото или видео для поста, истории или Pulse.",
          "microphonePermission": "podslushano использует микрофон, чтобы записать звук к вашему видео."
        }
      ],
      "expo-font",
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "podslushano определяет ваш город или деревню, чтобы показывать посты соседей в радиусе 50 км в ленте «Рядом»."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/app"
    },
    "extra": {
      "eas": {
        "projectId": "9ebb4a25-1e58-4360-8d5b-0bc0f0ddb026"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
